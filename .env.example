# Backend API (auth, users, Sage, Python jobs on Render in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Storage: local (dev) or r2 (Vercel production) ---
STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ambeon-demo
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Local paths (optional overrides; defaults to ../backend/...)
# SCRIPT_ROOT=E:\AMBEON\script\backend
# SCRIPT_DIR=E:\AMBEON\script\backend\scripts
# REPORTS_DIR=E:\AMBEON\script\backend\reports
# EXTRACTED_JSON_DIR=E:\AMBEON\script\backend\testing
# NEWLY_UPLOADED_DIR=E:\AMBEON\script\backend\newly_uploaded_report
# COMPANY_DIR=E:\AMBEON\script\backend\COMPANY
# PYTHON_BIN=python

# Production: proxy Python/SSE routes to Render (default when NODE_ENV=production)
# PROXY_PYTHON_TO_BACKEND=true
# BACKEND_PYTHON_URL=https://ambeon-api.onrender.com
